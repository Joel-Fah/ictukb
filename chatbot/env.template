# Local-first configuration for the ICT University assistant. setup.sh copies this to .env when .env doesn't exist.
# .env is git-ignored: never commit it.

# Local PostgreSQL + pgvector (docker compose service "db")
DATABASE_URL=postgresql://ictkb:ictkb@localhost:5432/ictkb

# staging also indexes status=draft documents
KB_ENV=staging

# Local embeddings only (intfloat/multilingual-e5-large). No cloud provider.
EMBEDDING_PROVIDER=fastembed
KB_WORKER_URL=
COHERE_API_KEY=
# Calibrated for e5 (docs/joelfah/01-local-setup.md); the cloud model bge-m3 uses 0.64
MIN_SIMILARITY=0.81

# Only used if the repo's FastAPI app is started; the chatbot doesn't need it
REQUIRE_API_KEY=false
ADMIN_TOKEN=

# Cloudinary disabled
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
